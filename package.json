{
  "name": "electron-react-template",
  "version": "0.1.0",
  "description": "Desktop app template: Electron, React, Vite, TypeScript",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "start": "electron .",
    "postinstall": "node scripts/rebuild-native.mjs",
    "sync-skills": "node scripts/sync-skills.mjs"
  },
  "keywords": [
    "electron",
    "react",
    "vite",
    "typescript",
    "template",
    "modern-css",
    "oklch",
    "desktop-app"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "better-sqlite3": "^12.11.1",
    "lucide-react": "^1.16.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.5",
    "electron": "^42.9.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vite-plugin-electron": "^1.1.1"
  },
  "allowScripts": {
    "better-sqlite3": true,
    "electron": true
  }
}
